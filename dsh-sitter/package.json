{
  "name": "@local/dsh-sitter",
  "version": "1.0.0",
  "private": true,
  "description": "贝草兰：坐在输入框上的像素桌宠——陪伴、监督、换装与学习提醒",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "docs",
    "icon.png"
  ],
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "pixel-art",
    "companion"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}